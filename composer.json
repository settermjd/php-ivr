{
    "name": "settermjd/php-ivr",
    "description": "This project shows the essentials of building an IVR in PHP with Twilio",
    "minimum-stability": "stable",
    "support": {
        "docs": "https://github.com/settermjd/php-ivr/README.md",
        "issues": "https://github.com/settermjd/php-ivr/issues"
    },
    "keywords": [
        "PHP",
        "IVR",
        "Slim Framework",
        "Twilio"
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "laminas/laminas-config-aggregator": "^1.19",
        "laminas/laminas-filter": "^3.4",
        "laminas/laminas-servicemanager": "^4.5",
        "monolog/monolog": "^3.10",
        "odan/session": "^6.5",
        "php-db/phpdb-sqlite": "^0.1.0",
        "php-di/slim-bridge": "^3.4",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "twilio/sdk": "^8.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "codeception/codeception": "^5.3",
        "codeception/module-asserts": "^3.3",
        "codeception/module-phpbrowser": "^4.0",
        "codeception/module-rest": "^3.4",
        "codeception/stub": "^4.3",
        "friendsofphp/php-cs-fixer": "^3.93",
        "laminas/laminas-coding-standard": "^3.1",
        "laminas/laminas-component-installer": "^3.7",
        "laminas/laminas-diactoros": "^3.8",
        "phpstan/phpdoc-parser": "^2.3",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.5"
    },
    "config": {
        "allow-plugins": {
            "laminas/laminas-component-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AppTest\\": "test/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "post-create-project-cmd": [
            "cp -v .env.example .env"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 0.0.0.0:8080 -t public"
        ],
        "static-analysis": "vendor/bin/phpstan analyse",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    }
}
